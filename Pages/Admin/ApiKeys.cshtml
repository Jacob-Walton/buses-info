@page
@model ApiKeysModel
@{
    ViewData["Title"] = "API Key Management";
    Layout = "_AdminLayout";
}

<div class="page-header">
    <h1>API Key Management</h1>
</div>

<div class="tabs">
    <button type="button" class="tab-button active" data-tab="requests">API Key Requests</button>
    <button type="button" class="tab-button" data-tab="keys">Active API Keys</button>
</div>

<div id="requests-tab" class="tab-content active">
    <div class="filter-bar">
        <select id="requestStatusFilter" class="form-select">
            <option value="all">All Requests</option>
            <option value="pending">Pending</option>
            <option value="approved">Approved</option>
            <option value="rejected">Rejected</option>
        </select>
        
        <div class="count-info">
            Showing <span id="requestCount">0</span> requests
        </div>
    </div>
    
    <div id="apiKeyRequestsLoading" class="loading-spinner">
        <div class="spinner"></div>
        <p>Loading requests...</p>
    </div>
    
    <div id="apiKeyRequestsError" class="error-message hidden">
        <i class="fas fa-exclamation-triangle"></i>
        <p>Failed to load API key requests. Please try again later.</p>
    </div>
    
    <div id="apiKeyRequestsEmpty" class="empty-state hidden">
        <i class="fas fa-inbox"></i>
        <p>No API key requests found.</p>
    </div>
    
    <div id="apiKeyRequestsList" class="requests-list hidden"></div>
</div>

<div id="keys-tab" class="tab-content">
    <div class="filter-bar">
        <input type="text" id="apiKeySearch" class="form-input" placeholder="Search by name, email or key...">
        
        <div class="count-info">
            Showing <span id="apiKeyCount">0</span> API keys
        </div>
    </div>
    
    <div id="apiKeysLoading" class="loading-spinner">
        <div class="spinner"></div>
        <p>Loading API keys...</p>
    </div>
    
    <div id="apiKeysError" class="error-message hidden">
        <i class="fas fa-exclamation-triangle"></i>
        <p>Failed to load API keys. Please try again later.</p>
    </div>
    
    <div id="apiKeysEmpty" class="empty-state hidden">
        <i class="fas fa-key"></i>
        <p>No API keys found.</p>
    </div>
    
    <div id="apiKeysList" class="api-keys-list hidden"></div>
</div>

<!-- Review Modal -->
<div id="reviewModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h2>Review API Key Request</h2>
            <button type="button" class="close-button">&times;</button>
        </div>
        <div class="modal-body">
            <input type="hidden" id="reviewRequestId">
            
            <div class="request-details">
                <div class="detail-row">
                    <div class="detail-label">User</div>
                    <div class="detail-value" id="reviewUserName"></div>
                </div>
                <div class="detail-row">
                    <div class="detail-label">Email</div>
                    <div class="detail-value" id="reviewUserEmail"></div>
                </div>
                <div class="detail-row">
                    <div class="detail-label">Requested</div>
                    <div class="detail-value" id="reviewRequestedAt"></div>
                </div>
                <div class="detail-row">
                    <div class="detail-label">Reason</div>
                    <div class="detail-value" id="reviewReason"></div>
                </div>
                <div class="detail-row">
                    <div class="detail-label">Intended Use</div>
                    <div class="detail-value" id="reviewIntendedUse"></div>
                </div>
            </div>
            
            <div class="review-form">
                <div class="form-group">
                    <label for="reviewNotes">Review Notes</label>
                    <textarea id="reviewNotes" class="form-input" rows="3" placeholder="Optional notes about this request..."></textarea>
                </div>
                
                <div id="rejectionReasonContainer" class="form-group hidden">
                    <label for="rejectionReason">Rejection Reason <span class="required">*</span></label>
                    <textarea id="rejectionReason" class="form-input" rows="3" placeholder="Please provide a reason for rejection..."></textarea>
                </div>
                
                <div class="review-actions">
                    <button type="button" id="cancelButton" class="btn-secondary">Cancel</button>
                    <button type="button" id="rejectButton" class="btn-danger">Reject</button>
                    <button type="button" id="approveButton" class="btn-primary">Approve</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Metrics Modal -->
<div id="metricsModal" class="modal">
    <div class="modal-content modal-lg">
        <div class="modal-header">
            <h2>API Key Usage Metrics</h2>
            <button type="button" class="close-button">&times;</button>
        </div>
        <div class="modal-body">
            <div id="metricsLoading" class="loading-spinner">
                <div class="spinner"></div>
                <p>Loading metrics...</p>
            </div>
            
            <div id="metricsContent" class="hidden">
                <div class="metrics-header">
                    <p><strong>User:</strong> <span id="metricsUserName"></span></p>
                    <p><strong>Key:</strong> <span id="metricsApiKey"></span></p>
                </div>
                
                <div class="metrics-overview">
                    <div class="metric-card small">
                        <div class="metric-title">Total Requests</div>
                        <div class="metric-value" id="metricsTotalRequests">0</div>
                    </div>
                    <div class="metric-card small">
                        <div class="metric-title">Today's Requests</div>
                        <div class="metric-value" id="metricsRequestsToday">0</div>
                    </div>
                    <div class="metric-card small">
                        <div class="metric-title">Avg Response Time</div>
                        <div class="metric-value" id="metricsAvgResponseTime">0 ms</div>
                    </div>
                </div>
                
                <div class="metrics-charts">
                    <div class="chart-container">
                        <h3>Requests Over Time</h3>
                        <canvas id="timeSeriesChart"></canvas>
                    </div>
                    <div class="chart-container">
                        <h3>Status Code Distribution</h3>
                        <canvas id="statusCodesChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>
    <script cdn src="/js/admin.js"></script>
}
