@page
@model AdminDashboardModel
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_AdminLayout";
}

<div class="admin-dashboard">
    <div class="dashboard-header">
        <h1>Dashboard</h1>
        <button id="refreshDashboard" class="btn-secondary">
            <i class="fas fa-sync-alt"></i> Refresh
        </button>
    </div>

    <div class="dashboard-metrics">
        <div class="metric-card">
            <i class="fas fa-users"></i>
            <div class="metric-content">
                <h3>Registered Users</h3>
                <div class="metric-value" id="userCount">0</div>
            </div>
        </div>
        
        <div class="metric-card">
            <i class="fas fa-key"></i>
            <div class="metric-content">
                <h3>Active API Keys</h3>
                <div class="metric-value" id="apiKeyCount">0</div>
            </div>
        </div>
        
        <div class="metric-card">
            <i class="fas fa-clock"></i>
            <div class="metric-content">
                <h3>Pending Requests</h3>
                <div class="metric-value" id="pendingRequestCount">0</div>
            </div>
        </div>
    </div>

    <div class="dashboard-actions">
        <div class="action-card">
            <h3>User Management</h3>
            <p>View, search, and manage user accounts. Update permissions and monitor user activity.</p>
            <a href="/Admin/Users" class="btn-primary">
                <i class="fas fa-users"></i> Manage Users
            </a>
        </div>
        
        <div class="action-card">
            <h3>API Key Management</h3>
            <p>Review API key requests, issue new keys, and monitor API usage metrics.</p>
            <a href="/Admin/ApiKeys" class="btn-primary">
                <i class="fas fa-key"></i> Manage API Keys
            </a>
        </div>
        
        <div class="action-card">
            <h3>Send Notifications</h3>
            <p>Send push notifications to all users or target specific users with important updates.</p>
            <a href="/Admin/Notifications" class="btn-primary">
                <i class="fas fa-bell"></i> Send Notifications
            </a>
        </div>
    </div>

    <div class="dashboard-footer">
        <p id="lastUpdated">Last updated: Never</p>
    </div>
</div>

@section Scripts {
    <script cdn src="/js/admin.js"></script>
}
