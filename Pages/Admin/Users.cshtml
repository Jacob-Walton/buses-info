@page
@model UsersModel
@{
    ViewData["Title"] = "User Management";
    Layout = "_AdminLayout";
}

<div class="page-header">
    <h1>User Management</h1>
</div>

<div class="filter-bar">
    <input type="text" id="userSearch" class="form-input" placeholder="Search by username or email...">
    
    <div class="count-info">
        Showing <span id="userCount">0</span> users
    </div>
</div>

<div id="usersLoading" class="loading-spinner">
    <div class="spinner"></div>
    <p>Loading users...</p>
</div>

<div id="usersError" class="error-message hidden">
    <i class="fas fa-exclamation-triangle"></i>
    <p>Failed to load users. Please try again later.</p>
</div>

<div id="usersEmpty" class="empty-state hidden">
    <i class="fas fa-users"></i>
    <p>No users found.</p>
</div>

<div id="usersList" class="hidden">
    <table class="data-table">
        <thead>
            <tr>
                <th>Username</th>
                <th>Email</th>
                <th>Email Status</th>
                <th>Account Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody id="usersTableBody">
            <!-- User rows will be added here via JavaScript -->
        </tbody>
    </table>
</div>

@section Scripts {
    <script cdn src="/js/admin.js"></script>
}
