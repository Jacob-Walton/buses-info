@{
    Layout = "_Layout";
    var currentPath = Context.Request.Path;
}

<div class="admin-container">
    <aside class="admin-sidebar">
        <div class="sidebar-header">
            <h2><i class="fas fa-tools"></i> Admin</h2>
        </div>
        <nav class="sidebar-nav">
            <ul>
                <li class="@(currentPath.Equals("/Admin") || currentPath.Equals("/Admin/Index") ? "active" : "")">
                    <a href="/Admin">
                        <i class="fas fa-chart-line"></i>
                        <span>Dashboard</span>
                    </a>
                </li>
                <li class="@(currentPath.Value.Contains("/Admin/ApiKeys") ? "active" : "")">
                    <a href="/Admin/ApiKeys">
                        <i class="fas fa-key"></i>
                        <span>API Keys</span>
                    </a>
                </li>
                <li class="@(currentPath.Value.Contains("/Admin/Users") ? "active" : "")">
                    <a href="/Admin/Users">
                        <i class="fas fa-users"></i>
                        <span>Users</span>
                    </a>
                </li>
                <li class="@(currentPath.Value.Contains("/Admin/Notifications") ? "active" : "")">
                    <a href="/Admin/Notifications">
                        <i class="fas fa-bell"></i>
                        <span>Notifications</span>
                    </a>
                </li>
            </ul>
        </nav>
        <div class="sidebar-footer">
            <a href="/" class="btn-secondary">
                <i class="fas fa-arrow-left"></i> Return to Site
            </a>
        </div>
    </aside>
    <main class="admin-content">
        @RenderBody()
    </main>
</div>

@section Scripts {
    <script src="~/js/admin.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
}
